{
    "version": "7.2",
     "screens": [
         {
            "id": "GET_STARTED",
            "title": "Get Started",
            "data": {},
             "layout": {
                 "type": "SingleColumnLayout",
                 "children": [
                     {
                         "type": "Form",
                        "name": "form",
                         "children": [
                             {
                                "type": "TextHeading",
                                "text": "Welcome to Our Course Registration!"
                             },
                             {
                                 "type": "TextBody",
                                "text": "Ready to enroll in our courses? Let's get started with your contact information."
                             },
                             {
                                 "type": "Footer",
                                "label": "Get Started",
                                 "on-click-action": {
                                    "name": "navigate",
                                    "next": {
                                        "type": "screen",
                                        "name": "CONTACT_INFO"
                                     }
                                 }
                             }
                         ]
                     }
                 ]
             }
         },
         {
            "id": "CONTACT_INFO",
            "title": "Contact Information",
            "data": {},
             "layout": {
                 "type": "SingleColumnLayout",
                 "children": [
                     {
                         "type": "Form",
                        "name": "form",
                         "children": [
                             {
                                "type": "TextHeading",
                                "text": "Contact Infomation"
                             },
                             {
                                 "type": "TextBody",
                                "text": "Tell us how we can reach you! Share your contact details and we’ll connect with you shortly."
                             },
                             {
                                 "type": "TextInput",
                                "name": "name",
                                "label": "Name",
                                "required": true
                             },
                             {
                                 "type": "TextInput",
                                "name": "email",
                                "label": "Email",
                                "required": true
                             },
                             {
                                 "type": "TextInput",
                                "name": "phone",
                                "label": "Phone",
                                "required": true
                             },
                             {
                                 "type": "Footer",
                                 "label": "Continue",
                                 "on-click-action": {
                                    "name": "navigate",
                                    "next": {
                                        "type": "screen",
                                        "name": "COURSE_DETAILS"
                                    },
                                     "payload": {
                                        "screen_1_name_0": "${form.name}",
                                        "screen_1_email_1": "${form.email}",
                                        "screen_1_phone_2": "${form.phone}"
                                     }
                                 }
                             }
                         ]
                     }
                 ]
             }
         },
        {
            "id": "COURSE_DETAILS",
            "title": "Course Details",
            "data": {
                "screen_1_name_0": {
                    "type": "string",
                    "__example__": "John Doe"
                },
                "screen_1_email_1": {
                    "type": "string",
                    "__example__": "john@example.com"
                },
                "screen_1_phone_2": {
                    "type": "string",
                    "__example__": "+1234567890"
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "form",
                        "children": [
                            {
                                "type": "TextHeading",
                                "text": "Course Details"
                            },
                            {
                                 "type": "TextBody",
                                "text": "Choose the course you’d like to sign up for."
                             },
                            {
                                "type": "Dropdown",
                                "name": "course",
                                "label": "Course",
                                "required": true,
                                "data-source": [
                                    {
                                        "id": "agentic_ai",
                                        "title": "Agentic AI"
                                    },
                                    {
                                        "id": "cdp",
                                        "title": "CDP"
                                    },
                                    {
                                        "id": "finance",
                                        "title": "Finance"
                                    }
                                ]
                            },
                            {
                                "type": "TextInput",
                                "name": "company_name",
                                "label": "Company Name",
                                "required": true
                            },
                            {
                                "type": "TextInput",
                                "name": "job_title",
                                "label": "Job Title",
                                "required": true
                            },
                            {
                                "type": "RadioButtonsGroup",
                                "name": "hrd_corp_registered",
                                "label": "Is your company Registered with HRD Corp?",
                                "required": true,
                                "data-source": [
                                    {
                                        "id": "yes",
                                        "title": "Yes"
                                    },
                                    {
                                        "id": "no",
                                        "title": "No"
                                    }
                                ]
                            },
                            {
                                "type": "Dropdown",
                                "name": "participants",
                                "label": "No of participants",
                                "required": true,
                                "data-source": [
                                    {
                                        "id": "1",
                                        "title": "1"
                                    },
                                    {
                                        "id": "2",
                                        "title": "2"
                                    },
                                    {
                                        "id": "3",
                                        "title": "3"
                                    },
                                    {
                                        "id": "4",
                                        "title": "4"
                                    },
                                    {
                                        "id": "5",
                                        "title": "5"
                                    },
                                    {
                                        "id": "6",
                                        "title": "6"
                                    },
                                    {
                                        "id": "7",
                                        "title": "7"
                                    },
                                    {
                                        "id": "8",
                                        "title": "8"
                                    },
                                    {
                                        "id": "9",
                                        "title": "9"
                                    },
                                    {
                                        "id": "10",
                                        "title": "10"
                                    },
                                    {
                                        "id": "11-20",
                                        "title": "11-20"
                                    },
                                    {
                                        "id": "20+",
                                        "title": "20+"
                                    }
                                ]
                            },
                            {
                                "type": "TextArea",
                                "name": "message",
                                "label": "Message",
                                "required": false
                            },
                            {
                                "type": "Footer",
                                "label": "Submit",
                                "on-click-action": {
                                    "name": "navigate",
                                    "next": {
                                        "type": "screen",
                                        "name": "COMPLETE"
                                    },
                                    "payload": {
                                        "screen_2_course_0": "${form.course}",
                                        "screen_2_company_name_1": "${form.company_name}",
                                        "screen_2_job_title_2": "${form.job_title}",
                                        "screen_2_hrd_corp_registered_3": "${form.hrd_corp_registered}",
                                        "screen_2_participants_4": "${form.participants}",
                                        "screen_2_message_5": "${form.message}",
                                        "screen_1_name_0": "${data.screen_1_name_0}",
                                        "screen_1_email_1": "${data.screen_1_email_1}",
                                        "screen_1_phone_2": "${data.screen_1_phone_2}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "COMPLETE",
            "title": "Thank You",
            "data": {
                "screen_2_course_0": {
                    "type": "string",
                    "__example__": "agentic_ai"
                },
                "screen_2_company_name_1": {
                    "type": "string",
                    "__example__": "Tech Corp"
                },
                "screen_2_job_title_2": {
                    "type": "string",
                    "__example__": "Software Engineer"
                },
                "screen_2_hrd_corp_registered_3": {
                    "type": "string",
                    "__example__": "yes"
                },
                "screen_2_participants_4": {
                    "type": "string",
                    "__example__": "5"
                },
                "screen_2_message_5": {
                    "type": "string",
                    "__example__": "Looking forward to the course"
                },
                "screen_1_name_0": {
                    "type": "string",
                    "__example__": "John Doe"
                },
                "screen_1_email_1": {
                    "type": "string",
                    "__example__": "john@example.com"
                },
                "screen_1_phone_2": {
                    "type": "string",
                    "__example__": "+1234567890"
                }
            },
            "terminal": true,
            "success": true,
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "form",
                        "children": [
                            {
                                "type": "TextHeading",
                                "text": "Thank You!"
                            },
                            {
                                "type": "TextBody",
                                "text": "Your inquiry has been submitted successfully. We'll get back to you soon!"
                            },
                            {
                                "type": "Footer",
                                "label": "Done",
                                "on-click-action": {
                                    "name": "complete",
                                    "payload": {
                                        "screen_2_course_0": "${data.screen_2_course_0}",
                                        "screen_2_company_name_1": "${data.screen_2_company_name_1}",
                                        "screen_2_job_title_2": "${data.screen_2_job_title_2}",
                                        "screen_2_hrd_corp_registered_3": "${data.screen_2_hrd_corp_registered_3}",
                                        "screen_2_participants_4": "${data.screen_2_participants_4}",
                                        "screen_2_message_5": "${data.screen_2_message_5}",
                                        "screen_1_name_0": "${data.screen_1_name_0}",
                                        "screen_1_email_1": "${data.screen_1_email_1}",
                                        "screen_1_phone_2": "${data.screen_1_phone_2}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        }
     ]
 }